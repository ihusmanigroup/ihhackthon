# Server configuration (copy to .env and fill in real values)
PORT=5000

# Supabase Database Pooler Connection
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"
SUPABASE_URL="https://<project-ref>.supabase.co"

# Google Gemini AI Live Integration
GEMINI_API_KEY="<your-gemini-api-key>"
GEMINI_MODEL="gemini-2.5-flash"
EMBEDDING_MODEL="gemini-embedding-001"

# System Controls
DEMO_MODE=false
SCHEDULER_ENABLED=true
OUTBOUND_EMAIL_ENABLED=false

# Optional external integrations (leave empty to run in simulation mode)
SEARCH_API_KEY=""
WHATSAPP_API_KEY=""
APP_URL="http://localhost:5173"
